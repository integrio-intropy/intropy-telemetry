<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Intropy.Telemetry</PackageId>
        <Description>Shared OpenTelemetry configuration used by the Intropy.Telemetry.AspNetCore and Intropy.Telemetry.ConsoleApp packages. Not usually referenced directly.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTelemetry" Version="1.18.0"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0"/>
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.18.0-beta.1"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0"/>
        <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.18.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Intropy.Telemetry.Test"/>
        <InternalsVisibleTo Include="Intropy.Telemetry.AspNetCore"/>
        <InternalsVisibleTo Include="Intropy.Telemetry.ConsoleApp"/>
    </ItemGroup>

</Project>
