<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Integrio</Authors>
    <Company>Integrio</Company>
    <Copyright>Copyright (c) 2026 Integrio</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/integrio-intropy/intropy-libs-telemetry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/integrio-intropy/intropy-libs-telemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>opentelemetry;telemetry;intropy</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
